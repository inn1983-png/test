{
  "description": "Module input/output contracts used by 00 controller before running modules. Requires are checked against manifest key_outputs, artifacts.db, and conventional module output paths.",
  "modules": {
    "01_novel_parser": {
      "requires": [],
      "produces": [{"module": "01_novel_parser", "name": "novel_analysis.json", "type": "json"}]
    },
    "02_script_writer": {
      "requires": [{"module": "01_novel_parser", "name": "novel_analysis.json"}],
      "produces": [{"module": "02_script_writer", "name": "script.json", "type": "json"}]
    },
    "03_character_system": {
      "requires": [
        {"module": "01_novel_parser", "name": "novel_analysis.json"},
        {"module": "02_script_writer", "name": "script.json"}
      ],
      "produces": [{"module": "03_character_system", "name": "characters.json", "type": "json"}]
    },
    "04_scene_system": {
      "requires": [
        {"module": "01_novel_parser", "name": "novel_analysis.json"},
        {"module": "02_script_writer", "name": "script.json"}
      ],
      "produces": [{"module": "04_scene_system", "name": "scenes.json", "type": "json"}]
    },
    "05_prop_system": {
      "requires": [
        {"module": "01_novel_parser", "name": "novel_analysis.json"},
        {"module": "02_script_writer", "name": "script.json"}
      ],
      "produces": [{"module": "05_prop_system", "name": "props.json", "type": "json"}]
    },
    "06_storyboard": {
      "requires": [
        {"module": "02_script_writer", "name": "script.json"},
        {"module": "03_character_system", "name": "characters.json"},
        {"module": "04_scene_system", "name": "scenes.json"},
        {"module": "05_prop_system", "name": "props.json"}
      ],
      "produces": [{"module": "06_storyboard", "name": "storyboard.json", "type": "json"}]
    },
    "07_storyboard_image": {
      "requires": [{"module": "06_storyboard", "name": "storyboard.json"}],
      "produces": [{"module": "07_storyboard_image", "name": "image_manifest.json", "type": "json"}]
    },
    "08_audio": {
      "requires": [{"module": "02_script_writer", "name": "script.json"}],
      "produces": [
        {"module": "08_audio", "name": "final_audio.wav", "type": "audio"},
        {"module": "08_audio", "name": "audio_timeline.json", "type": "json"},
        {"module": "08_audio", "name": "subtitle.srt", "type": "subtitle"},
        {"module": "08_audio", "name": "subtitle.ass", "type": "subtitle"}
      ]
    },
    "09_video": {
      "requires": [
        {"module": "07_storyboard_image", "name": "image_manifest.json"},
        {"module": "08_audio", "name": "final_audio.wav"},
        {"module": "08_audio", "name": "audio_timeline.json"}
      ],
      "produces": [
        {"module": "09_video", "name": "video_manifest.json", "type": "json"},
        {"module": "09_video", "name": "final_video.mp4", "type": "video"}
      ]
    },
    "10_final_assembly": {
      "requires": [
        {"module": "09_video", "name": "video_manifest.json", "type": "json"},
        {"module": "08_audio", "name": "final_audio.wav", "type": "audio"},
        {"module": "09_video", "name": "final_video.mp4", "type": "video", "optional": true},
        {"module": "09_video", "name": "clips", "type": "video_dir", "optional": true},
        {"module": "08_audio", "name": "subtitle.srt", "type": "subtitle", "optional": true},
        {"module": "08_audio", "name": "subtitle.ass", "type": "subtitle", "optional": true}
      ],
      "produces": [
        {"module": "10_final_assembly", "name": "final.mp4", "type": "video"},
        {"module": "10_final_assembly", "name": "final_manifest.json", "type": "json"},
        {"module": "10_final_assembly", "name": "final_meta.json", "type": "json"}
      ]
    }
  }
}
